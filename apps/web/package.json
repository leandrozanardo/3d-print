{
  "name": "@fix-my-print/web",
  "version": "0.0.0",
  "private": true,
  "description": "Fix My Print browser shell (Vite + React + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
