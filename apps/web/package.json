    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fix-my-print/engine": "workspace:*",
    "@fix-my-print/formats": "workspace:*",
    "@fix-my-print/formats-3mf": "workspace:*",
    "@fix-my-print/geometry": "workspace:*",
    "buffer": "6.0.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "adm-zip": "0.5.16",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vitest": "3.2.4"
  }
}
