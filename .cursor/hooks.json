{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/repo-boundary.mjs",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/repo-boundary.mjs",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/repo-boundary.mjs",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
